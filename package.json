{
  "name": "palimorph",
  "version": "0.1.4",
  "description": "Run Claude Code against any NVIDIA NIM, LM Studio, or Ollama model. Pick a model, get a throwaway Anthropic-compatible proxy, launch claude — nothing is left behind when it exits.",
  "type": "module",
  "bin": {
    "palimorph": "bin/palimorph.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node bin/palimorph.js",
    "test": "node test/e2e.mjs && node test/errors.mjs && node test/session.mjs && node test/providers.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "claude-code",
    "claude",
    "nvidia",
    "nim",
    "llm",
    "cli",
    "anthropic",
    "proxy",
    "openai",
    "ai",
    "agent"
  ],
  "author": "Ahmet Atar (https://github.com/ahmetatar)",
  "license": "MIT",
  "homepage": "https://github.com/ahmetatar/palimorph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetatar/palimorph.git"
  },
  "bugs": {
    "url": "https://github.com/ahmetatar/palimorph/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
